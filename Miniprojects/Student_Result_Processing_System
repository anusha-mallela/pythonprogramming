# Mini Project 1: Student Result Processing System
print("Student Result Processing System")
name = input("Enter Student Name: ")
subjects = []
total = 0
for i in range(1, 6):
    mark = float(input(f"Enter marks for Subject {i}: "))
    subjects.append(mark)
    total += mark
percentage = total / 5
# Grade Calculation
if percentage >= 90:
    grade = "A+"
elif percentage >= 80:
    grade = "A"
elif percentage >= 70:
    grade = "B"
elif percentage >= 60:
    grade = "C"
elif percentage >= 50:
    grade = "D"
else:
    grade = "F"
if percentage >= 50:
    result = "PASS"
else:
    result = "FAIL"
print("\n STUDENT REPORT")
print("Student Name :", name)
for i in range(5):
    print(f"Subject {i+1} Marks :", subjects[i])
print("------------------------------------")
print("Total Marks  :", total)
print("Percentage   : {:.2f}%".format(percentage))
print("Grade        :", grade)
print("Result       :", result)
print("====================================")
